{
  "manifest_version": 3,
  "name": "Pickwick Video Saver",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "description": "Detect web media, queue video and audio downloads, and save locally from a persistent side panel.",
  "permissions": ["tabs", "sidePanel", "nativeMessaging", "storage", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "popup.html" },
  "action": { "default_title": "Open Video Saver" }
}
