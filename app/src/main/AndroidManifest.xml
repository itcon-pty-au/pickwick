<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Self-update: hand a downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Offline downloads run as a foreground service with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Google TV / Android TV: no touchscreen required, leanback optional so the
         same APK installs on phones, tablets and TV boxes. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".PickwickApp"
        android:label="@string/app_name"
        android:banner="@drawable/ic_launcher"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Pickwick"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="true"
        android:usesCleartextTraffic="true"><!-- phone→TV pairing runs plain HTTP on the home LAN -->
        <!-- The three backup attributes protect the parents' curation (blocks,
             safe-list, channels, screen-time rules) across reinstalls:
             cloud/device-transfer backup where the platform offers it, and
             hasFragileUserData adds a "Keep app data" choice on uninstall. -->

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shows up in the Google TV launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Pairing deep link from the TV's QR code -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pickwick" android:host="pair" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Fetches parent-approved videos for offline play, one at a time. -->
        <service
            android:name=".data.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Serves the downloaded update APK to the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
